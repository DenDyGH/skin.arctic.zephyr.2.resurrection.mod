<?xml version="1.0" encoding="utf-8"?>
<window>
    <defaultcontrol always="true">6</defaultcontrol>
    <controls>
        <include>Global_Overlay</include>
        <control type="group">
            <centertop>50%</centertop>
            <centerleft>50%</centerleft>
            <height>720</height>
            <width>1280</width>
            <include content="Dialog_Standard_Group">
                <param name="centertop" value="595" />
            </include>
            <!-- Header -->
            <control type="label">
                <left>dialog_pad</left>
                <include>Dialog_Standard_Header</include>
                <label>$LOCALIZE[737]: $INFO[ListItem.Label,, - ]$INFO[ListItem.Label2,#,]</label>
            </control>
            <include content="Object_Control">
                <param name="control">image</param>
                <top>80</top>
                <height>1</height>
                <width>1230</width>
                <texture colordiffuse="dialog_fg_12">common/white.png</texture>
                <align>center</align>
                <left>25</left>
                <right>25</right>
            </include>
            <!-- Color picker panel -->
            <control type="panel" id="6">
                <left>20</left>
                <top>100</top>
                <width>900</width>
                <bottom>26</bottom>
                <onup>6</onup>
                <ondown>6</ondown>
                <onleft>9001</onleft>
                <onright>61</onright>
                <orientation>vertical</orientation>
                <pagecontrol>61</pagecontrol>
                <viewtype label="100">icon</viewtype>
                <itemlayout height="80" width="80">
                    <control type="group">
                        <control type="image">
                            <top>3</top>
                            <left>8</left>
                            <width>80</width>
                            <height>80</height>
                            <bordersize>2</bordersize>
                            <texture border="0">common/white.png</texture>
                            <colordiffuse>$INFO[ListItem.Label2]</colordiffuse>
                            <aspectratio>stretch</aspectratio>
                        </control>
                    </control>
                </itemlayout>
                <focusedlayout height="80" width="80">
                    <control type="group">
                        <animation effect="zoom" time="200" tween="sine" easing="inout" start="100" end="118" center="auto">Focus</animation>
                        <control type="image">
                            <top>-2</top>
                            <left>3</left>
                            <width>90</width>
                            <height>90</height>
                            <texture border="20" colordiffuse="ccffffff">common/box.png</texture>
                        </control>
                        <control type="image">
                            <top>3</top>
                            <left>8</left>
                            <width>80</width>
                            <height>80</height>
                            <texture border="0">common/white.png</texture>
                            <colordiffuse>$INFO[ListItem.Label2]</colordiffuse>
                            <aspectratio>stretch</aspectratio>
                        </control>
                    </control>
                </focusedlayout>
            </control>
            <control type="scrollbar" id="61">
                <left>930</left>
                <top>100</top>
                <width>8</width>
                <bottom>26</bottom>
                <onleft condition="Control.IsVisible(6)">6</onleft>
                <onright>9000</onright>
                <orientation>vertical</orientation>
            </control>
            <control type="grouplist" id="9000">
                <left>950</left>
                <top>103</top>
                <width>315</width>
                <onleft>61</onleft>
                <onright>6</onright>
                <orientation>vertical</orientation>
                <itemgap>10</itemgap>
                <!-- Close -->
                <control type="button" id="3012">
                    <label>$LOCALIZE[15067]</label>
                    <include>Dialog_Standard_Right_Buttons</include>
                    <onclick>Close</onclick>
                </control>
            </control>
            <control type="label">
                <right>20</right>
                <height>50</height>
                <bottom>20</bottom>
                <align>right</align>
                <label>$INFO[Container(6).CurrentItem] / $INFO[Container(6).NumItems]</label>
                <font>font_small_28</font>
            </control>
        </control>
    </controls>
</window>
